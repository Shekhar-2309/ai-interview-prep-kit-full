# --- LLM provider ---
# Groq API key (free tier, no credit card required). Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- Database ---
# MongoDB connection string. For local dev: mongodb://localhost:27017/interview-prep-kit
# For deployed: use your MongoDB Atlas free-tier connection string.
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# --- Sessions ---
# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- App config ---
# "development" or "production". Controls SSRF guard behavior in retrieval/fetchPage.ts —
# private/loopback addresses are only rejected in production, since the batch command's
# test fixtures may be served from http://localhost:PORT.
NODE_ENV=development

# The deployed frontend's origin, e.g. https://your-app.vercel.app. Required in
# production for CORS + cross-domain session cookies (see server/app.ts and
# server/middleware/auth.ts). Leave unset in local dev — defaults to allowing
# any origin, which is fine for localhost but must NOT be left unset in production.
FRONTEND_ORIGIN=

# Port the Express server listens on.
PORT=4000
